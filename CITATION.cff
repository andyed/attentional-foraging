cff-version: 1.2.0
# `version` is the AllSERP enrichment data release (tag allserp-v1.1.1), distinct
# from the paper anchor tag v1.0.0 (CIKM reference state). Bump it when typed AOI
# values change. See CHANGELOG.md and docs/allserp-v1.1.0-migration.md.
message: "If you use this software or the AllSERP enrichment, please cite the AllSERP paper and the AdSERP dataset paper listed below."
type: software
title: "Attentional Foraging in Search: Initial Sampling and Recurrent Evaluation"
version: "1.1.1"
date-released: "2026-09-07"
authors:
  - family-names: Edmonds
    given-names: Andy
repository-code: "https://github.com/andyed/attentional-foraging"
abstract: >-
  Search-process research on the AdSERP gaze, cursor, scroll and pupil
  recordings: how people sample a results page, evaluate and revisit results,
  and commit to a selection. Implements the typed AOI extraction (AllSERP),
  the per-element behavioral inventory and the Key Claims pipeline described
  in the AllSERP paper.
preferred-citation:
  type: article
  title: "AllSERP: Exhaustive Per-Element Enrichment of the Versatile AdSERP Dataset"
  authors:
    - family-names: Edmonds
      given-names: Andy
  year: 2026
  identifiers:
    - type: other
      value: "arXiv:2605.04949"
      description: "arXiv preprint"
  url: "https://arxiv.org/abs/2605.04949"
references:
