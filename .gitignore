# Data (downloaded from Zenodo, not ours)
AdSERP/data/fixation-data/
AdSERP/data/mouse-movement-data/
AdSERP/data/trial-metadata/
AdSERP/data/*.zip
AdSERP/data/serps/

# Python
.venv/
__pycache__/

# Output (reproducible from notebook)
convergence_results.json
phase_results.json

# Keep plot PNGs for README embedding
# plots are reproducible but needed for GitHub rendering
.DS_Store
site/
AdSERP/
docs/drafts/
docs/plans/

# Agent workspace dirs
.claude/
.claire/

# claude-mem scaffolding — regenerated per subdir, breaks SSG globs.
# Keep the real root CLAUDE.md only.
**/CLAUDE.md
!/CLAUDE.md

# LaTeX build artifacts
docs/arxiv/*.aux
docs/arxiv/*.bbl
docs/arxiv/*.blg
docs/arxiv/*.log
docs/arxiv/*.out

# Audit/diagnostic scripts (local utility, not production)
notebooks-v2/_*.py

# Pre-fix backup JSONs (local reproducibility)
*.prefix-bug.json
*.html
# Replay app source HTML is kept in git; generated data dir is not
!docs/schul-replay/*.html
docs/schul-replay/data/

# Per-record figure caches — large (10-15 MB), reproducible from source scripts
scripts/output/figures/per_record_*.json

# Thursday RIPA2 meeting prep — internal-only, not paper artifacts
scripts/output/ripa2_meet_visuals/

# Full schul-replay corpus — 917 MB / 1,640 files, 238 of them per-trial screen
# recordings (trial.mp4, up to 27 MB each) derived from AdSERP, which is itself
# gitignored above as not-ours-to-redistribute. The repo ships a 5-trial demo set
# (1017_Q05, 1021_Q07, 1042_Q05/06/10) which stays tracked — gitignore does not
# untrack. Add a new demo trial deliberately with `git add -f`.
docs/schul-replay/trials/

# Regenerable analysis output. ~2,900 untracked JSONs / 100 MB accumulate here from
# exploratory runs; the ~358 tracked files are the curated ones that back a figure,
# a Key Claim, or a paper table. Default is ignore — promote deliberately with
# `git add -f` when an output becomes a cited artifact.
scripts/output/
# Scratch from the organic→hybrid attribution migration; superseded, not artifacts.
scripts/output/*_HYBRID_BACKUP/

# Incoming collaborator material — others' UNPUBLISHED data/notebooks, not ours to
# open-source (this repo is public). e.g. allawati-ai-overviews/ = Sara Allawati's
# AI-Overviews dataset + her ports of our v2 notebooks, plus the comparison/draft that
# quote her pre-publication numbers. Whitelist a specific shareable file with
# `!collab/<path>` only once permission is explicitly granted.
collab/
